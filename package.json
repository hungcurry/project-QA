{
  "name": "qa",
  "version": "1.0.0",
  "description": "> 網址",
  "main": "index.js",
  "scripts": {
    "dev:css": "npx tailwindcss -i ./src/css/style.css -o ./src/dist/all.min.css --watch",
    "dev:js": "npx esbuild ./src/js/script.js --bundle --watch --outfile=./src/dist/all.min.js",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:js\"",
    "build:css": "npx tailwindcss -i ./src/css/style.css -o ./src/dist/all.min.css --minify",
    "build:js": "npx esbuild ./src/js/script.js --bundle --minify --outfile=./src/dist/all.min.js",
    "build": "npm run build:css && npm run build:js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "i18next": "^26.5.4"
  }
}
